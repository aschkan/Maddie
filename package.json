{
  "name": "maddie",
  "version": "1.0.0",
  "private": true,
  "description": "A map where you set a start and a destination and it draws the route.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${DEV_PORT:-5007}",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-8087}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit && eslint . && node --test \"test/**/*.test.ts\"",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "mongodb": "^7.6.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
