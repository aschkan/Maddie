# ─────────────────────────────────────────────────────────────────────────────
# Maddie — every environment variable, and what happens without it.
#
# THE APP RUNS FULLY WITH THIS FILE EMPTY. A safety tool that needs a credit
# card before it can tell a woman whether a street is lit is a tool most of the
# people who need it cannot run. A key may only ever buy a BETTER answer, never
# a working one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public origin ─────────────────────────────── REQUIRED in production
# The canonical https origin, NOT the loopback port. Guardian share links are
# absolute: a link to 127.0.0.1:8087 fails at exactly the moment someone is
# relying on it to see where a woman is.
NEXT_PUBLIC_APP_URL=https://maddie.arsaces.ir

# ── Region ────────────────────────────────────────────────
# NOT cosmetic. Recorded-crime data is national, so this decides which source
# can answer at all. Pointed at the wrong country the app reports "no recorded
# crime" everywhere, which reads as reassurance rather than as ignorance.
REGION=NL
DEFAULT_CENTER_LAT=52.3728
DEFAULT_CENTER_LNG=4.8936
NEXT_PUBLIC_DEFAULT_CENTER_LAT=52.3728
NEXT_PUBLIC_DEFAULT_CENTER_LNG=4.8936
GEOCODING_COUNTRY=nl

# ── Dutch open data (keyless) ─────────────────────────────
# PDOK is the government's own geocoder over the BAG register, and — critically
# — it returns the CBS neighbourhood codes the police figures are published
# against. Verify the crime table before trusting it:
#   npm run verify:nl-crime                 # search both catalogues
#   npm run verify:nl-crime -- 47022NED --labels
PDOK_LOCATIESERVER_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
NL_CRIME_ODATA_URL=https://dataderden.cbs.nl/ODataApi/odata
# 47022NED = offence type x wijk/buurt x MONTH. 47013NED is the same data per
# municipality, and one figure for all of Amsterdam is the same number on the
# safest street and the worst one.
NL_CRIME_TABLE=47022NED
NL_CRIME_WINDOW_MONTHS=12

# ── Outbound proxy ────────────────────────────────────────
# Leave blank on a box with open egress. Comma-separated pool, YOURS FIRST:
# ranked by TRUST TIER, then latency within a tier. A public proxy operator
# sees which hosts this server looks up and when, and for an app that reasons
# about where a woman is at what hour that must not be traded away for 600 ms.
# A bare host:port is fine; http:// is assumed. SOCKS is ignored with a warning
# (undici's ProxyAgent cannot speak it). LAN and loopback are never proxied.
UPSTREAM_PROXY_URL=
# NO_PROXY shape, suffix matched: liara.ir covers api.liara.ir, not notliara.ir
UPSTREAM_PROXY_BYPASS=liara.ir,liara.run
# Blank probes https://api.pdok.nl/ — an upstream the app actually depends on,
# never a neutral connectivity endpoint.
UPSTREAM_PROXY_PROBE_URL=
UPSTREAM_PROXY_PROBE_INTERVAL_MS=600000
UPSTREAM_TIMEOUT_MS=20000

# ── Basemap: served BY THIS APP at /api/map/* ─────────────
# Every other upstream is fetched server-side, so the proxy covers it. Tiles
# are fetched by the BROWSER, and a browser on a blocked network gets zoom
# controls, attribution and no ground at all.
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_TILES_UPSTREAM=

# ── Keys: NEITHER is required ─────────────────────────────
# Reviews are the ONE capability with no open substitute — review text is the
# only source for "do the staff here step in when a woman is being bothered".
# Needs billing: console.cloud.google.com/google/maps-apis/credentials
# Enable Places API (New) + Street View Static API only. IP-restrict it.
GOOGLE_MAPS_SERVER_API_KEY=
# Free, no card, issued immediately: mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

GEOCODING_PROVIDER=pdok
ROUTING_PROVIDER=valhalla
VENUES_PROVIDER=auto
IMAGERY_PROVIDER=auto
# So they mail you instead of banning the server's IP. Their policy is 1 req/s,
# enforced by ban rather than by 429; the app serialises to it.
NOMINATIM_CONTACT_EMAIL=

# ── AI: local on the LAN ──────────────────────────────────
# Free per call (which is what makes it affordable to score forty route
# segments), private (this app reasons about where a woman is, at what hour,
# alone or not), and impossible to rate-limit or cut off for a billing failure.
LOCAL_AI_HOST=192.168.11.165
LOCAL_AI_URL=
LOCAL_AI_MODEL=gemma-3-4b-it
LOCAL_AI_VISION_MODEL=
AI_LOCAL_FIRST=true
# Per-task overrides, e.g. {"local:infer-segment":"qwen2.5-3b-instruct"}
# Tasks: infer-location, infer-segment, street-view-vision, analyse-reviews,
#        moderate-report, compare-routes, analyse-interview
AI_TASK_MODELS=
# Cloud fallback for when the LAN box is off. Reachable from this network
# directly, so it is bypassed rather than proxied.
CLOUD_AI_BASE=
CLOUD_AI_KEY=
CLOUD_AI_MODEL=
CLOUD_AI_VISION_MODEL=
CLOUD_AI_PROVIDER=
# OFF: the LAN model is never proxied by rule, and the cloud one is reachable.
AI_USE_PROXY=false
AI_PROXY_URL=
AI_MAX_CONCURRENT=4
AI_TIMEOUT_MS=45000
AI_ENABLED=true

# ── Operator + storage ────────────────────────────────────
# UNSET MEANS OFF: operator endpoints refuse everyone rather than defaulting
# open.  openssl rand -hex 32
ADMIN_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MADDIE_DATA_DIR=.data

# ── OSM / Overpass ────────────────────────────────────────
# Self-host it (docker-compose.yml). The public mirrors return 429/502/504 and
# 20-second timeouts continuously, and no client-side backoff fixes that.
OVERPASS_ENDPOINTS=http://127.0.0.1:12345/api/interpreter
# Overpass hands out a couple of query SLOTS per IP; what earns a 429 is
# several requests AT ONCE. Raise ONLY against a mirror you host.
OVERPASS_MAX_CONCURRENT=1
OVERPASS_MIN_INTERVAL_MS=0
OVERPASS_TIMEOUT_MS=20000
# One deadline for a WHOLE tile batch, not per tile.
OVERPASS_DEADLINE_MS=15000
OSM_ENABLED=true
WEATHER_ENABLED=true
CRIME_DATA_ENABLED=true

STREET_VIEW_ANALYSIS_ENABLED=true
STREET_VIEW_MAX_IMAGES=4

# ── Application ───────────────────────────────────────────
NEXT_PUBLIC_EMERGENCY_NUMBER=112
REPORT_RATE_LIMIT_PER_HOUR=12
# MUST be changed: a known salt makes the rate-limit hashes guessable.
# openssl rand -hex 32
ANON_HASH_SALT=
LOG_LEVEL=info
